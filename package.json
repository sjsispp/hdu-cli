{
  "name": "hdu-cli",
  "version": "0.1.0",
  "description": "A safe, structured CLI for public Hangzhou Dianzi University information.",
  "type": "module",
  "bin": {
    "hdu": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:live": "HDU_LIVE_TEST=1 vitest run tests/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
