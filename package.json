{
  "name": "hdu-cli",
  "version": "0.4.0",
  "description": "A safe, structured CLI for public Hangzhou Dianzi University information.",
  "type": "module",
  "bin": {
    "hdu": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:live": "HDU_LIVE_TEST=1 vitest run tests/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
